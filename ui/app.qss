/* Ubuntu terminal inspired: intentionally low contrast and no saturated CTA buttons. */
* {
    font-family: "Ubuntu", "Noto Sans", sans-serif;
    font-size: 13px;
    color: #e6dce7;
}
QMainWindow, #root, #page { background: #1c1420; }
#header {
    background: #241a2a;
    border-bottom: 1px solid #46334e;
}
#logo { color: #eadfeb; font-family: "Ubuntu Mono"; font-size: 14px; font-weight: 700; letter-spacing: 1.1px; }
#version { color: #a99baa; font-family: "Ubuntu Mono"; font-size: 11px; }
#nav {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #c7b7c9;
    padding: 7px 11px;
}
#nav:hover { background: #302137; border-color: #62466d; color: #f2e9f3; }
#nav:pressed { background: #382641; }
#sidebar {
    background: #201720;
    border-right: 1px solid #46334e;
}
#section { color: #a98db0; font-family: "Ubuntu Mono"; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
#device {
    background: #19121c;
    border: 1px solid #49364e;
    border-radius: 4px;
    padding: 10px;
    color: #ede3ee;
}
#device span { color: #aa9aaa; }
QPushButton {
    background: #2a202f;
    border: 1px solid #4e3a55;
    border-radius: 4px;
    color: #ddcfdf;
    padding: 9px 10px;
    text-align: left;
}
QPushButton:hover { background: #34263a; border-color: #8a6191; color: #fff7ff; }
QPushButton:pressed { background: #1c151f; border-color: #b17ab8; }
QPushButton:disabled { background: #211923; border-color: #38283d; color: #796d7b; }
#emergency { color: #dfb4bd; background: #2a1b24; border-color: #754450; }
#emergency:hover { background: #37202c; border-color: #a55a69; color: #ffe0e4; }
#quietAction { background: #302137; border-color: #74527c; color: #ead8ed; font-weight: 700; text-align: center; }
#quietAction:hover { background: #432d4b; border-color: #a878ae; }
#log { color: #b7a9b9; background: #181119; border: 1px solid #3d2c42; border-radius: 4px; padding: 9px; min-height: 58px; }
#statusbar { background: #181119; border-top: 1px solid #46334e; }
#pageTitle { color: #f1e7f2; font-size: 25px; font-weight: 700; }
#subtitle { color: #ab9bac; padding-bottom: 12px; }
#card, #largeCard { background: #241a29; border: 1px solid #493650; border-radius: 5px; }
#card { min-height: 94px; }
#caption { color: #b295b8; font-family: "Ubuntu Mono"; font-size: 10px; font-weight: 700; letter-spacing: .8px; }
#cardValue { color: #f0e4f1; font-size: 19px; font-weight: 700; }
#panelTitle { color: #eaddec; font-size: 15px; font-weight: 700; }
#placeholder { color: #b6a4b8; font-size: 15px; padding: 25px 0; }
#measurement { color: #dbbddf; font-family: "Ubuntu Mono"; font-size: 16px; padding: 8px 0 18px; }
QComboBox, QDoubleSpinBox {
    background: #181119;
    border: 1px solid #503b57;
    border-radius: 3px;
    padding: 8px;
    min-width: 170px;
    color: #eadfeb;
}
QComboBox:hover, QDoubleSpinBox:hover { border-color: #8a6191; }
QComboBox QAbstractItemView { background: #251b2a; border: 1px solid #6f4d76; selection-background-color: #48304f; }
QCheckBox { color: #cdbdce; spacing: 8px; padding: 5px 0; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #77547e; background: #19121c; border-radius: 2px; }
QCheckBox::indicator:checked { background: #715178; border-color: #b383bb; }
QProgressBar { background: #181119; border: 1px solid #503b57; border-radius: 3px; min-height: 22px; text-align: center; color: #e4d8e5; }
QProgressBar::chunk { background: #604568; border-radius: 2px; }
QTableWidget { background: #19121c; alternate-background-color: #211723; border: 1px solid #493650; gridline-color: #3a293e; color: #ded1df; }
QTableWidget::item { padding: 5px; }
QTableWidget::item:selected { background: #48304f; color: #fff7ff; }
QHeaderView::section { background: #2a1e2f; color: #cbb8ce; border: 0; border-right: 1px solid #493650; border-bottom: 1px solid #493650; padding: 7px; font-family: "Ubuntu Mono"; }
QScrollBar:vertical { background: #1b131d; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #56405d; min-height: 25px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
